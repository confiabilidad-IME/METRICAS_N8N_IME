# ============================================================
# Auditoria n8n (IME) - configuracion
# Copia este archivo a .env y completa los valores. NO subas .env al repo.
# ============================================================

# --- n8n: instancia ---------------------------------------------------------
# URL base de la instancia (sin barra final)
N8N_BASE_URL=https://n8n.srv1673971.hstgr.cloud

# --- n8n: API publica (estado de servicios y ejecuciones en tiempo real) ----
# Se crea en n8n: Settings -> n8n API -> Create an API key
# Se usa para: GET /api/v1/workflows y GET /api/v1/executions
# Tambien es la que necesita la credencial "n8n API" del flujo AUD03.
N8N_API_KEY=

# --- n8n: API de auditoria (flujo AUD04, metricas de negocio) ---------------
# Ruta del webhook de produccion
N8N_AUDIT_WEBHOOK_PATH=/webhook/audit/metricas
# Token compartido. Es el valor de la fila "api_token" de la data table
# Audit_Config en n8n. Se envia en el header x-audit-token.
N8N_AUDIT_TOKEN=

# --- Opciones ---------------------------------------------------------------
# ID del proyecto n8n donde viven los flujos (Confiabilidad IME)
N8N_PROJECT_ID=BOiyY1XRPt5eKWiN
# Zona horaria usada para agrupar metricas por dia
APP_TIMEZONE=America/Bogota
# Cada cuantos segundos consultar n8n
POLL_INTERVAL_SECONDS=60
# Timeout de las peticiones a n8n (ms)
N8N_REQUEST_TIMEOUT_MS=15000

# --- App --------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Inicio de sesion ---------------------------------------------------------
# El tablero pide usuario y contrasena. Usuarios por defecto: users.default.json (solo hashes scrypt).
# Gestion: npm run user:init | user:add -- <usuario> | user:remove -- <usuario> | user:hash | user:list
# Secreto para firmar las sesiones (minimo 32 caracteres, aleatorio). Sin el, las sesiones se cierran al reiniciar.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUDIT_SESSION_SECRET=
# Duracion de la sesion en horas (por defecto 12)
AUDIT_SESSION_HOURS=12
# Usuarios extra o reemplazos como JSON (para hostings sin disco): [{"usuario":"maria","hash":"scrypt$..."}]
AUDIT_USERS=
# Publicar en un hosting: escuchar en todas las interfaces y confiar en el proxy del hosting (HTTPS)
# AUDIT_HOST=0.0.0.0
# AUDIT_TRUST_PROXY=1
# AUDIT_COOKIE_SECURE=1
# Solo desarrollo local: AUDIT_AUTH=off desactiva el login (el servidor se niega si AUDIT_HOST no es 127.0.0.1)
# AUDIT_AUTH=off

# --- Vercel -------------------------------------------------------------------
# En Vercel estas mismas variables se definen en Settings -> Environment Variables (no se sube el .env).
# AUDIT_SESSION_SECRET es OBLIGATORIO alli (minimo 32 caracteres aleatorios): cada peticion puede caer en otra instancia.
